<!-- BOTÃO WHATSAPP -->
<a
  id="whatsappFloat"
  href="#"
  target="_blank"
  rel="noopener"
  aria-label="Enviar cadastro pelo WhatsApp"
>
  ☎
  <span>CONFIRMAR PAGAMENTO</span>
</a>

<style>
#whatsappFloat {
  position: fixed;
  right: 18px;
  bottom: 18px;
  z-index: 9999;

  width: 60px;
  height: 60px;

  border-radius: 50%;
  display: grid;
  place-items: center;

  background: #25D366;
  color: white;

  font-size: 28px;
  text-decoration: none;

  border: 2px solid white;
  box-shadow: 0 10px 30px rgba(0,0,0,.45);

  transition: .2s;
}

#whatsappFloat:hover {
  transform: scale(1.08);
}

#whatsappFloat span {
  position: absolute;
  right: 70px;

  white-space: nowrap;

  background: #06152d;
  color: white;

  padding: 8px 12px;
  border-radius: 8px;

  font-size: 11px;
  font-weight: 900;

  opacity: 0;
  pointer-events: none;

  transition: .2s;
}

#whatsappFloat:hover span {
  opacity: 1;
}

@media(max-width:560px) {
  #whatsappFloat {
    right: 14px;
    bottom: 14px;
    width: 55px;
    height: 55px;
  }

  #whatsappFloat span {
    display: none;
  }
}
</style>

<script>

/* ================================
   CONFIGURAÇÕES
================================ */

const WHATSAPP_MAFIA_AZUL = "5512992332388";

const PIX_MAFIA_AZUL = "57137123000196";


/* ================================
   PLANOS
================================ */

const PLANOS_MAFIA_AZUL = {

  Bronze: {
    valor: 10,
    pagamento: "https://mpago.la/23Jjfqo"
  },

  Prata: {
    valor: 20,
    pagamento: "https://mpago.la/2TRyk8G"
  },

  Ouro: {
    valor: 30,
    pagamento: "https://mpago.la/2Yef2LK"
  }

};


/* ================================
   NÚMERO DO SÓCIO
================================ */

function gerarNumeroSocio() {

  let numero =
    Number(localStorage.getItem("numeroSocio") || "0") + 1;

  localStorage.setItem(
    "numeroSocio",
    String(numero)
  );

  return String(numero).padStart(4, "0");
}


/* ================================
   CADASTRO
================================ */

async function cadastrarSocio() {

  const nome =
    document.getElementById("nome").value.trim();

  const telefone =
    document.getElementById("telefone").value.trim();

  const email =
    document.getElementById("email").value.trim();

  const cidade =
    document.getElementById("cidade").value.trim();

  const plano =
    document.getElementById("plano").value;


  if (
    !nome ||
    !telefone ||
    !email ||
    !cidade ||
    !plano
  ) {

    alert("Preencha todos os campos.");

    return;
  }


  const planoDados =
    PLANOS_MAFIA_AZUL[plano];


  /* GERA NÚMERO ÚNICO */

  const numeroSocio =
    gerarNumeroSocio();


  /* SALVA OS DADOS */

  const socio = {

    numero: numeroSocio,

    nome: nome,

    telefone: telefone,

    email: email,

    cidade: cidade,

    plano: plano,

    valor: planoDados.valor,

    pix: PIX_MAFIA_AZUL

  };


  localStorage.setItem(
    "ultimoSocio",
    JSON.stringify(socio)
  );


  /* MOSTRA NÚMERO NA TELA */

  const memberNumber =
    document.getElementById("memberNumber");

  if (memberNumber) {

    memberNumber.textContent =
      numeroSocio;

  }


  const memberCard =
    document.getElementById("memberCard");

  if (memberCard) {

    memberCard.classList.add("show");

  }


  /* ================================
     MENSAGEM WHATSAPP
  ================================ */

  const mensagem = `

Olá! Acabei de realizar meu cadastro no Sócio Máfia Azul.

🆔 NÚMERO DO SÓCIO: ${numeroSocio}

👤 Nome: ${nome}

📱 WhatsApp: ${telefone}

📧 E-mail: ${email}

📍 Cidade: ${cidade}

🏆 Plano: ${plano}

💰 Valor: R$ ${planoDados.valor},00

💳 PIX: ${PIX_MAFIA_AZUL}

Já realizei o pagamento e quero confirmar meu cadastro.

`.trim();


  const whatsappURL =
    `https://wa.me/${WHATSAPP_MAFIA_AZUL}?text=${encodeURIComponent(mensagem)}`;


  /* ================================
     ABRE PAGAMENTO
  ================================ */

  window.open(
    planoDados.pagamento,
    "_blank"
  );


  /* ================================
     ABRE WHATSAPP
  ================================ */

  setTimeout(() => {

    window.open(
      whatsappURL,
      "_blank"
    );

  }, 1200);

}


/* ================================
   BOTÃO FLUTUANTE WHATSAPP
================================ */

document
  .getElementById("whatsappFloat")
  .addEventListener("click", function(e) {

    e.preventDefault();


    const dados =
      JSON.parse(
        localStorage.getItem("ultimoSocio") || "null"
      );


    let mensagem;


    if (dados) {

      mensagem = `

Olá! Sou da Máfia Azul e quero confirmar meu pagamento.

🆔 Número do sócio: ${dados.numero}

👤 Nome: ${dados.nome}

📱 WhatsApp: ${dados.telefone}

📧 E-mail: ${dados.email}

📍 Cidade: ${dados.cidade}

🏆 Plano: ${dados.plano}

💰 Valor: R$ ${dados.valor},00

💳 PIX: ${PIX_MAFIA_AZUL}

Já realizei o pagamento e quero finalizar meu cadastro.

`.trim();

    } else {

      mensagem = `

Olá! Quero me cadastrar no Sócio Máfia Azul.

💳 PIX: ${PIX_MAFIA_AZUL}

Gostaria de realizar meu cadastro.

`.trim();

    }


    const url =
      `https://wa.me/${WHATSAPP_MAFIA_AZUL}?text=${encodeURIComponent(mensagem)}`;


    window.open(
      url,
      "_blank"
    );

});


</script>
